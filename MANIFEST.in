include README.md NOTICE.md LICENSE CITATION.cff CHANGELOG.md pyproject.toml setup.py
recursive-include capabilities *.json
include agents/research_workbench.toml
recursive-include docs *.md
recursive-include launcher *.md *.yaml *.sh
recursive-include scripts *.py *.sh
recursive-include examples *.json *.py *.md *.xyz
global-exclude *.py[cod]
global-exclude .DS_Store
prune .venv
prune build
prune dist
prune .pytest_cache
